  m_Script: {fileID: 11500000, guid: cfbb1f4770f50d945963fc18ab6851bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fortal.Display.TutorialPopup
  pages:
  - picture: {fileID: 21300000, guid: b5a5ee83893c4abbb8dd545d590f2af3, type: 3}
    title: PICK YOUR DOG
    body: 'PUT ON YOUR TAG AND STEP ONTO THE FLOOR.

      STAND ON A DOG CARD FOR
      2 SECONDS TO PICK IT!'
  - picture: {fileID: 21300000, guid: 8ec4c0095a9258d408014b92a0949365, type: 3}
    title: WANTED!
    body: 'THE WALL SHOWS WHO TO CATCH

      AND HOW MUCH THEIR BOUNTY IS.'
  - picture: {fileID: 21300000, guid: 9eed6e7fef695d14fabce2172d16aa1b, type: 3}
    title: CATCH THE THIEF
    body: 'RUN INTO A THIEF TO CATCH IT AND TAKE ITS BOUNTY.

      IT HIDES IN BINS
      AND BUSHES: STAND GUARD TO FLUSH IT OUT!'
  - picture: {fileID: 21300000, guid: 4f79370f4686fbb4e80263af1d006148, type: 3}
    title: WATCH OUT!
    body: 'GET OUT OF THE RED RING BEFORE THE BOMB GOES OFF.

      BUMPING INTO
      A PASSER-BY COSTS YOU 5$!'
  - picture: {fileID: 21300000, guid: dff30d4a1c65c714a9a02a8c38148436, type: 3}
    title: STUN GUN
    body: 'GRAB A STUN GUN AND STAY CLOSE TO A THIEF.

      IT LOCKS ON AND FIRES
      BY ITSELF!'
  - picture: {fileID: 21300000, guid: 13f50ae9006e6104483139e7fc9c41d2, type: 3}
    title: MINI GAMES
    body: 'BETWEEN STAGES, STAND ON THE RING OF YOUR ANSWER.

      GET IT RIGHT
      FOR BONUS CASH!'
  - picture: {fileID: 21300000, guid: b87b3a11a52913f478fe20e4c641974d, type: 3}
    title: MOST WANTED
    body: 'CATCH THE BOSS IN THE FINAL CHASE.

      THE MOST CASH AT THE END WINS!'
